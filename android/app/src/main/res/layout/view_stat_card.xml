<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/stat_accent_dot"
        android:layout_width="@dimen/stat_dot_size"
        android:layout_height="@dimen/stat_dot_size"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/btn_icon_bg"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xs"
        android:accessibilityLiveRegion="polite"
        android:maxLines="1"
        android:text="@string/menu_stat_crowns"
        android:textAppearance="@style/TextAppearance.App.Numeric" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xxs"
        android:maxLines="1"
        android:text="@string/menu_stat_crowns"
        android:textAppearance="@style/TextAppearance.App.Label" />

</merge>
