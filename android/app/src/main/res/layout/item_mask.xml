<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mask_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mask_item_height"
    android:layout_margin="@dimen/space_xs"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/stroke_purple_soft"
    app:strokeWidth="@dimen/stroke_clay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <FrameLayout
            android:id="@+id/mask_disc"
            android:layout_width="@dimen/mask_item_disc"
            android:layout_height="@dimen/mask_item_disc"
            android:background="@drawable/clay_disc_primary">

            <ImageView
                android:id="@+id/mask_sprite"
                android:layout_width="@dimen/mask_item_sprite"
                android:layout_height="@dimen/mask_item_sprite"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_mask_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_trickster_mask" />

            <ImageView
                android:id="@+id/mask_lock"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                android:visibility="gone"
                app:tint="@color/text_on_dark" />

        </FrameLayout>

        <TextView
            android:id="@+id/mask_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/wardrobe_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mask_ability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/wardrobe_ability_none"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/mask_shard_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:visibility="gone"
            app:indicatorColor="@color/primary_purple"
            app:trackColor="@color/surface_lilac"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mask_action"
            style="@style/Widget.App.Button.Equip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/wardrobe_equip" />

        <TextView
            android:id="@+id/mask_state_footer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_xxs"
            android:gravity="center"
            android:text="@string/wardrobe_equipped"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textColor="@color/primary_purple"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
