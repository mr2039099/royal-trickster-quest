<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/clay_sheet_cream"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/nav_bar_inset">

    <View
        android:id="@+id/settings_grab"
        android:layout_width="@dimen/menu_grab_width"
        android:layout_height="@dimen/menu_grab_height"
        android:layout_centerHorizontal="true"
        android:background="@drawable/grab_bar_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/settings_grab"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:textSize="22sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_close"
        style="@style/Widget.App.Button.Icon"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_below="@id/settings_grab"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/space_xs"
        android:contentDescription="@string/cd_close"
        app:backgroundTint="@color/surface_lilac"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/primary_purple" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/settings_close"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_switch_sound"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height"
                android:text="@string/settings_sound"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_switch_haptics"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height"
                android:text="@string/settings_haptics"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_switch_motion"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height"
                android:text="@string/settings_reduced_motion"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/settings_difficulty_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/settings_difficulty"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/settings_difficulty_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_difficulty_easy"
                    style="@style/Widget.App.Toggle.Chip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/settings_difficulty_easy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_difficulty_royal"
                    style="@style/Widget.App.Toggle.Chip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/settings_difficulty_royal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_difficulty_jester"
                    style="@style/Widget.App.Toggle.Chip"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/settings_difficulty_jester" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/settings_economy_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/settings_economy_note"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_reset"
                style="@style/Widget.App.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/settings_reset" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
