<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_gradient">

    <ImageView
        android:id="@+id/result_texture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/result_banner"
        android:layout_width="0dp"
        android:layout_height="@dimen/result_banner_height"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="@dimen/space_lg"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/stroke_cream_soft"
        app:strokeWidth="@dimen/stroke_clay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg">

            <ImageView
                android:id="@+id/result_banner_sprite"
                android:layout_width="@dimen/result_banner_sprite"
                android:layout_height="@dimen/result_banner_sprite"
                android:contentDescription="@string/cd_result_crown"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_crown_coin" />

            <TextView
                android:id="@+id/result_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:text="@string/result_title_win"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textSize="26sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.royaltrickster.quest.core.ui.HeartsBarView
        android:id="@+id/result_hearts"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_xxl"
        android:layout_marginTop="@dimen/space_sm"
        app:layout_constraintEnd_toEndOf="@id/result_banner"
        app:layout_constraintStart_toStartOf="@id/result_banner"
        app:layout_constraintTop_toBottomOf="@id/result_banner" />

    <LinearLayout
        android:id="@+id/result_stat_row_one"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_hearts">

        <com.royaltrickster.quest.core.ui.StatCardView
            android:id="@+id/result_stat_crowns"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height_tall"
            android:layout_weight="1" />

        <com.royaltrickster.quest.core.ui.StatCardView
            android:id="@+id/result_stat_distance"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height_tall"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_stat_row_two"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_lg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_stat_row_one">

        <com.royaltrickster.quest.core.ui.StatCardView
            android:id="@+id/result_stat_combo"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height_tall"
            android:layout_weight="1" />

        <com.royaltrickster.quest.core.ui.StatCardView
            android:id="@+id/result_stat_shards"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height_tall"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/result_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:gravity="center"
        android:text="@string/menu_tagline"
        android:textColor="@color/text_on_dark"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/result_stat_row_one"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/result_stat_row_one" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/result_unlock_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/result_unlock_height"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:visibility="gone"
        app:cardBackgroundColor="@color/scrim_card"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_card"
        app:layout_constraintBottom_toTopOf="@id/result_cta_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/stroke_purple_soft"
        app:strokeWidth="@dimen/stroke_clay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md">

            <ImageView
                android:id="@+id/result_unlock_icon"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:contentDescription="@string/cd_mask_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_mask_shard" />

            <TextView
                android:id="@+id/result_unlock_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:text="@string/wardrobe_title"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textSize="15sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/result_cta_again"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_primary_height"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/result_cta_again"
        app:icon="@drawable/ic_replay"
        app:layout_constraintBottom_toTopOf="@id/result_cta_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/result_cta_menu"
        style="@style/Widget.App.Button.SecondaryOnDark"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/nav_bar_inset"
        android:text="@string/result_cta_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/result_confetti_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
