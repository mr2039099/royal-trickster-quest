<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_sheet_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_art_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.60" />

    <ImageView
        android:id="@+id/menu_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_palace_hall"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="@id/guide_art_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_backdrop_fade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/overlay_menu_fade"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/guide_art_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.royaltrickster.quest.core.ui.MaskBadgeView
        android:id="@+id/menu_mask_badge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/menu_badge_height"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/status_bar_inset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/menu_crown_pill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/menu_badge_height"
        android:layout_marginTop="@dimen/status_bar_inset"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/clay_pill_gold"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/menu_crown_icon"
            android:layout_width="@dimen/crown_pill_icon"
            android:layout_height="@dimen/crown_pill_icon"
            android:contentDescription="@string/cd_crown_counter"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_crown_coin" />

        <TextView
            android:id="@+id/menu_crown_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:accessibilityLiveRegion="polite"
            android:text="@string/menu_stat_crowns"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/menu_hero"
        android:layout_width="@dimen/menu_hero_size"
        android:layout_height="@dimen/menu_hero_size"
        android:layout_marginBottom="@dimen/space_xs"
        android:contentDescription="@string/cd_trickster_hero"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_trickster_hero"
        app:layout_constraintBottom_toTopOf="@id/guide_sheet_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menu_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardElevation="@dimen/elevation_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_sheet_top"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SheetTop"
        app:strokeColor="@color/stroke_purple_soft"
        app:strokeWidth="@dimen/stroke_clay">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/menu_sheet_padding"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/menu_sheet_padding"
            android:paddingBottom="@dimen/nav_bar_inset">

            <View
                android:id="@+id/menu_grab"
                android:layout_width="@dimen/menu_grab_width"
                android:layout_height="@dimen/menu_grab_height"
                android:background="@drawable/grab_bar_handle"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/menu_title"
                android:textAppearance="@style/TextAppearance.App.Headline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_grab" />

            <TextView
                android:id="@+id/menu_tagline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="2"
                android:text="@string/menu_tagline"
                android:textAppearance="@style/TextAppearance.App.Body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_title" />

            <HorizontalScrollView
                android:id="@+id/menu_chip_scroll"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_chip_row_height"
                android:layout_marginBottom="@dimen/space_md"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintBottom_toTopOf="@id/menu_stat_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_tagline"
                app:layout_constraintVertical_bias="1.0">

                <LinearLayout
                    android:id="@+id/menu_chip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/menu_stat_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/menu_cta_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.royaltrickster.quest.core.ui.StatCardView
                    android:id="@+id/menu_stat_crowns"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_weight="1" />

                <com.royaltrickster.quest.core.ui.StatCardView
                    android:id="@+id/menu_stat_masks"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/menu_first_run_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/menu_hint_first_run"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/primary_purple"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/menu_stat_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/menu_stat_row" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_cta_play"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_primary_height"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/menu_cta_play"
                app:icon="@drawable/ic_crown"
                app:layout_constraintBottom_toTopOf="@id/menu_secondary_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/menu_secondary_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_btn_masks"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/menu_btn_masks"
                    app:icon="@drawable/ic_mask" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_btn_settings"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/menu_btn_settings"
                    app:icon="@drawable/ic_settings" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
