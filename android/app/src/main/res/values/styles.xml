<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">38sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/text_on_dark</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Numeric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_primary_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/accent_red</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="elevation">@dimen/elevation_button</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="iconTint">@color/text_on_dark</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primary_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface_lilac</item>
        <item name="strokeColor">@color/stroke_purple_soft</item>
        <item name="strokeWidth">@dimen/stroke_clay</item>
        <item name="cornerRadius">@dimen/radius_chip</item>
        <item name="rippleColor">@color/ripple_purple</item>
        <item name="iconTint">@color/primary_purple</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_xs</item>
    </style>

    <style name="Widget.App.Button.SecondaryOnDark" parent="Widget.App.Button.Secondary">
        <item name="android:minHeight">@dimen/button_secondary_height</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="strokeColor">@color/stroke_cream_soft</item>
        <item name="iconTint">@color/text_on_dark</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">@dimen/icon_medium</item>
        <item name="iconTint">@color/text_on_dark</item>
        <item name="backgroundTint">@color/stroke_gold_soft</item>
        <item name="cornerRadius">@dimen/radius_chip</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Button.Control" parent="Widget.Material3.Button">
        <item name="android:minWidth">@dimen/button_control_width</item>
        <item name="android:minHeight">@dimen/button_control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="cornerRadius">@dimen/radius_chip</item>
        <item name="elevation">@dimen/space_xs</item>
        <item name="iconSize">@dimen/icon_large</item>
        <item name="iconTint">@color/text_on_dark</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Button.Jump" parent="Widget.Material3.Button">
        <item name="android:minWidth">@dimen/button_jump_width</item>
        <item name="android:minHeight">@dimen/button_control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/secondary_gold</item>
        <item name="cornerRadius">@dimen/radius_chip</item>
        <item name="elevation">@dimen/space_xs</item>
        <item name="rippleColor">@color/ripple_purple</item>
    </style>

    <style name="Widget.App.Button.Destructive" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/ripple_purple</item>
    </style>

    <style name="Widget.App.Button.Equip" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="cornerRadius">@dimen/radius_chip</item>
        <item name="elevation">@dimen/space_xxs</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Card.Clay" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/stroke_purple_soft</item>
        <item name="strokeWidth">@dimen/stroke_clay</item>
    </style>

    <style name="ShapeAppearance.App.SheetTop" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.App.Toggle.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/stroke_purple_soft</item>
        <item name="strokeWidth">@dimen/stroke_clay</item>
    </style>
</resources>
